[Unit]
Description=RPi-VJ Mobile Rig Appliance Service
After=network.target sound.target pipewire.service
Wants=sound.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/vj
ExecStart=/home/pi/vj/target/release/vj-app --show /media/show/show.toml
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

# Performance environment
Environment=RUST_LOG=info
Environment=WGPU_BACKEND=vulkan
LimitRTPRIO=95
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
